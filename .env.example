# ============================================================
# Polymarket Edge — environment configuration
# Copy to .env and fill in the values you need.
# Every variable has a safe default; API keys enable extra features.
# ============================================================

# ---- General -----------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Storage -----------------------------------------------
# Async SQLAlchemy URL. Docker compose overrides the host to "db".
DATABASE_URL=postgresql+asyncpg://polybot:polybot@localhost:5432/polybot
REDIS_URL=redis://localhost:6379/0

# ---- Workers / scanner -------------------------------------
# Run scanner/edge/AI/risk loops inside the API process (dev convenience).
# In docker-compose a dedicated worker container runs them instead.
RUN_WORKERS_IN_APP=false
SCAN_INTERVAL_SECONDS=60
MAX_MARKETS_PER_SCAN=2000
ORDERBOOK_TOP_N=150
SNAPSHOT_RETENTION_DAYS=90
GRAPH_REFRESH_MINUTES=60
ML_RETRAIN_HOURS=24

# ---- Anthropic (AI analysis engine) ------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_ANALYSIS_ENABLED=true
AI_MAX_ANALYSES_PER_CYCLE=8
AI_ANALYSIS_COOLDOWN_MINUTES=120
AI_MIN_CONFIDENCE_ALERT=0.75
AI_MAX_CONCURRENCY=2

# ---- External data sources (all optional) ------------------
NEWSAPI_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_USER_AGENT=polymarket-edge/1.0
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_BASE_URL=https://api.binance.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# ---- Trading & risk ----------------------------------------
# paper = simulated fills, live = real orders via py-clob-client
TRADING_MODE=paper
AUTO_TRADE_ENABLED=false
STARTING_BANKROLL=10000
FEE_RATE=0.0
SPREAD_BUFFER=0.005
KELLY_FRACTION=0.25
MAX_RISK_PER_TRADE_PCT=2.0
MAX_MARKET_EXPOSURE_PCT=10.0
MAX_CATEGORY_EXPOSURE_PCT=25.0
MAX_TOTAL_EXPOSURE_PCT=60.0
MAX_DAILY_LOSS_PCT=5.0
MAX_DRAWDOWN_PCT=15.0
STOP_LOSS_PCT=25.0
MIN_EDGE_SCORE_TO_TRADE=70
MIN_LIQUIDITY_TO_TRADE=1000
MAX_OPEN_POSITIONS=25
AUTO_HEDGE_ENABLED=true
HEDGE_TRIGGER_LOSS_PCT=15.0

# ---- Polymarket live trading (only for TRADING_MODE=live) --
# Requires: pip install py-clob-client
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Telegram alerts ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EDGE_ALERT_THRESHOLD=75
ARB_ALERT_MIN_EDGE=0.01
ALERT_COOLDOWN_MINUTES=60
BIG_MOVE_ALERT_PCT=10.0

# ---- Machine learning --------------------------------------
ML_ENABLED=true
ML_MIN_TRAINING_SAMPLES=200
MODELS_DIR=models

# ---- Frontend ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/feed
